# Example environment variables for nVestPadi
# Copy this file to `.env` and fill in real values. Do NOT commit secrets.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENV=development
SERVER_PORT=3000

# ---------------------------------------------------------------------------
# LLM / Embeddings
# ---------------------------------------------------------------------------
# Provider: 'openai' or 'gemini'
LLM_PROVIDER=openai

# Shared API key (preferred). Falls back to OPENAI_API_KEY for OpenAI.
LLM_API_KEY=

# OpenAI (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Gemini / Google (only if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us-central1
# Recommended model for Gemini embeddings (768-dim)
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Qdrant vector store
# ---------------------------------------------------------------------------
QDRANT_HOST=
QDRANT_KEY=
QDRANT_ENABLED=true

# Collection name — all ingested data goes into this collection.
# Change to use separate collections per environment (e.g. nvestpadi_prod).
QDRANT_COLLECTION_NAME=nvestpadi

# Must match the output dimension of your embedding model:
#   OpenAI text-embedding-ada-002 / text-embedding-3-small → 1536
#   OpenAI text-embedding-3-large                          → 3072
#   Gemini text-embedding-004                              → 768
EMBEDDING_VECTOR_SIZE=1536

# ---------------------------------------------------------------------------
# SQLite (document metadata store)
# ---------------------------------------------------------------------------
# Leave blank to use the default ingestor.db in the project root.
DATABASE_URL=

# ---------------------------------------------------------------------------
# NGX market settings
# ---------------------------------------------------------------------------
# Number of pages to fetch from the NGX REST API (300 companies/page).
NGX_PAGES=1

# ---------------------------------------------------------------------------
# US stock market settings
# ---------------------------------------------------------------------------
# Comma-separated list of ticker symbols to fetch from Yahoo Finance.
# Leave blank to use the built-in default list (top 30 S&P 500 by market cap).
US_MARKET_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,JPM,V,UNH

# Historical data range for getUSHistory / getNGXHistory.
# Supported Yahoo Finance ranges: 1d 5d 1mo 3mo 6mo 1y 2y 5y 10y ytd max
US_HISTORY_RANGE=1y

# ---------------------------------------------------------------------------
# App tuning
# ---------------------------------------------------------------------------
MAX_CONCURRENCY=2
CHROME_PATH_ON_HOST=/usr/bin/google-chrome-stable

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
ALARMS_WHOOK_URL=

TRIGGER_SCRAPPER_URL=
TRIGGER_SCRAPPER_STATUS=

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# - After updating `.env`, restart the app so environment variables reload.
# - QDRANT_COLLECTION_NAME + EMBEDDING_VECTOR_SIZE must be consistent across
#   all runs; changing them after data is ingested requires re-indexing.
# - Set QDRANT_ENABLED=false to run without Qdrant (in-memory only).
