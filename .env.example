# nVestPadi configuration
#
# Copy to `.env` and fill in only what you need — EVERY setting is optional.
# With an empty .env you get a self-hosted server: sign up at /signup (the first
# account becomes the owner), then sync prices, analyze, screen and set alerts.
# Real environment variables always take precedence over this file.
# Run `pnpm nvest doctor` to check your setup.

# ── App ──────────────────────────────────────────────────────────────────────────
# self-hosted | cloud
#   self-hosted: first account is the owner, everything unlimited, sign-up closes after the owner
#   cloud:       the hosted product — open sign-up, Free/Pro plans, Paystack billing
APP_MODE=self-hosted
# Public URL people use to reach the app (used in emails and payment redirects).
# Defaults to http://localhost:$PORT. Use https:// in production: it turns on Secure cookies and HSTS.
APP_URL=
# development | production | test   (production hides internal error details from API clients)
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# SQLite file holding prices, accounts, watchlists and alerts (created automatically)
DATABASE_PATH=data/nvestpadi.db
# Use PostgreSQL instead of SQLite by setting a connection URL; it takes precedence over DATABASE_PATH.
# Tables are created automatically on first start. Managed providers (Aiven, Neon, Supabase, RDS…) usually
# need ?sslmode=require; use sslmode=verify-full plus DATABASE_CA_CERT to also verify the server's certificate.
#   postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
# PEM CA certificate for sslmode=verify-ca / verify-full (write line breaks as \n)
# Only if your host gives the password separately from the URL (ignored when the URL already has one).
DATABASE_PASSWORD=
DATABASE_CA_CERT=
# Maximum connections in the pool (keep it under your provider's connection limit)
DATABASE_POOL_MAX=5

# ── Web server (`nvest serve`) ───────────────────────────────────────────────────
# 127.0.0.1 = this machine only. Use 0.0.0.0 behind a reverse proxy or in Docker.
HOST=127.0.0.1
PORT=3000
# true when running behind a reverse proxy / load balancer (uses X-Forwarded-For for rate limits)
TRUST_PROXY=false
# Override who may sign up: true = anyone, false = nobody (the owner creates accounts with
# `nvest users create`). Blank = mode default (cloud: open; self-hosted: closed after the owner).
ALLOW_SIGNUP=

# ── Email — verification, password reset and email alerts ─────────────────────────
# Without these, emails (including reset links) are written to the server log instead.
# https://resend.com → API Keys. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# ── Billing (cloud mode) — Paystack subscriptions ────────────────────────────────
# Paystack dashboard → Settings → API keys; create a monthly "Pro" plan under Products → Plans.
# Webhook URL to set in Paystack: <APP_URL>/api/billing/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE=

# ── Telegram bot ─────────────────────────────────────────────────────────────────
# Create a bot with @BotFather. Users connect it from Settings (one tap) to get their own
# alerts, daily digest and /watchlist /portfolio /ask in a private chat.
TELEGRAM_BOT_TOKEN=
# Optional: a channel or group (e.g. -1001234567890 or @yourchannel) for daily market digests.
# Add the bot to it as an admin. Anyone there can also use /market /quote /analyze /ask.
TELEGRAM_CHAT_ID=
# Optional: when set and APP_URL is https, Telegram pushes updates to <APP_URL>/api/integrations/telegram
# (recommended in production). Otherwise the server long-polls. 16+ letters, digits, _ or -.
TELEGRAM_WEBHOOK_SECRET=

# ── Discord ──────────────────────────────────────────────────────────────────────
# Optional: a channel webhook (Channel settings → Integrations → Webhooks) for daily market digests.
DISCORD_WEBHOOK_URL=
# Optional slash commands (/market /quote /analyze /ask): create an app at
# https://discord.com/developers/applications, set its Interactions Endpoint URL to
# <APP_URL>/api/integrations/discord, then run `pnpm nvest bots setup`.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# ── Digests ──────────────────────────────────────────────────────────────────────
# Daily market digests to the channels above, and personal digests to users who opted in
# (sent after each market's close: NGX 15:00, US 21:30, crypto 07:00 UTC). Needs `nvest serve`.
DAILY_DIGEST=true

# ── Live prices ──────────────────────────────────────────────────────────────────
# While a market is open (NGX 10:00–14:30 WAT, US 9:30–16:00 New York, crypto always),
# `nvest serve --sync-every N` also re-syncs it every LIVE_SYNC_MINUTES so prices, portfolio
# values, signals and alerts stay current through the session. 0 turns this off.
LIVE_SYNC_MINUTES=5

# ── AI — enables Ask, search and document ingestion ──────────────────────────────
# openai | gemini
AI_PROVIDER=
# OpenAI key (sk-...) or Gemini key (AIza... — https://aistudio.google.com/app/apikey)
AI_API_KEY=
# Optional model overrides. Defaults:
#   openai → chat gpt-4.1-mini,     embeddings text-embedding-3-small
#   gemini → chat gemini-2.5-flash, embeddings gemini-embedding-001
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
# Leave blank for the model's native size. Set only to match an existing Qdrant
# collection (e.g. 768 / 1536); works with text-embedding-3-* and gemini-embedding-001.
AI_EMBEDDING_DIMENSIONS=

# ── Qdrant vector store — required for search, ingest and document-grounded answers ──
# e.g. http://localhost:6333 or https://<cluster>.cloud.qdrant.io
QDRANT_URL=
# Leave blank for a local instance
QDRANT_API_KEY=
# Created automatically on first ingest, sized to your embedding model
QDRANT_COLLECTION=nvestpadi

# ── Markets ──────────────────────────────────────────────────────────────────────
# Comma-separated tickers for `nvest sync us`; blank = top 30 S&P 500 stocks
US_SYMBOLS=
# Optional free CoinGecko "demo" key for higher crypto rate limits (https://www.coingecko.com/en/api)
COINGECKO_API_KEY=

# ── Persistent storage on hosts with ephemeral disks (Docker image only) ────────────
# When LITESTREAM_BUCKET is set, the container restores the SQLite database from S3-compatible
# storage on boot and replicates every change within ~1s, so accounts survive restarts on hosts
# like Render's free plan. Free options: Backblaze B2 or Cloudflare R2 (10 GB each).
# Ignored when running with `pnpm nvest`.
LITESTREAM_BUCKET=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# S3 endpoint, e.g. https://s3.us-west-004.backblazeb2.com or https://<account-id>.r2.cloudflarestorage.com
LITESTREAM_ENDPOINT=
# e.g. us-west-004 for B2 (the middle part of the endpoint), auto for R2
LITESTREAM_REGION=
# Folder inside the bucket (default: nvestpadi)
LITESTREAM_PATH=
