{
	"name": "nvestpadi",
	"version": "3.0.0",
	"description": "AI market intelligence for the Nigerian Exchange (NGX) and US equities: market data sync, technical analysis, screening, alerts, and grounded AI Q&A over your own research.",
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@10.7.1",
	"engines": {
		"node": ">=22.13"
	},
	"bin": {
		"nvest": "dist/cli/index.js"
	},
	"files": ["dist", "public"],
	"scripts": {
		"nvest": "tsx --disable-warning=ExperimentalWarning src/cli/index.ts",
		"dev": "tsx watch --disable-warning=ExperimentalWarning src/cli/index.ts serve",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --disable-warning=ExperimentalWarning dist/cli/index.js serve",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "tsx --disable-warning=ExperimentalWarning --test test/*.test.ts",
		"check": "pnpm typecheck && pnpm lint && pnpm test"
	},
	"dependencies": {
		"@qdrant/js-client-rest": "^1.16.2",
		"cheerio": "^1.1.2",
		"unpdf": "^2.2.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^25.0.3",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
	}
}
